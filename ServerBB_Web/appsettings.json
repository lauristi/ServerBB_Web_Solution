{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "NLog": {
    "targets": {
      "file": {
        "type": "File",
        "fileName": "GlobalLog.log",
        "layout": "${longdate}|${level:uppercase=true}|${message} ${exception:format=tostring}"
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Debug",
        "writeTo": "file"
      }
    ]
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      //"Protocols": "Http1AndHttp2"
    },
    "StaticFiles": { "ServeFrom": "wwwroot" },
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5023"
      }
      //"Https": {
      //  "Url": "https://localhost:5025"
      //}
    }
  },
  "ConnectionSettings": {
    "ApiBaseAddress": "http://localhost:5020/",
    "BindAddress": "localhost:5020",
    "BindPort": 5023
  }
}

